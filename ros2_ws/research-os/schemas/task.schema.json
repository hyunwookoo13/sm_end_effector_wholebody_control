{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research OS Task",
  "type": "object",
  "required": ["task_id", "title", "status", "objective", "related_requirements", "done_conditions", "tests"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{8}-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "objective": {"type": "string"},
    "related_requirements": {"type": "array", "items": {"type": "string"}},
    "done_conditions": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array"}
  }
}
